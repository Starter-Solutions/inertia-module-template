{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "{{ORGANIZATION_SLUG}}/{{MODULE_SLUG}}",
    "description": "{{MODULE_TITLE}} module for Laravel and Inertia.js applications.",
    "type": "library",
    "license": "{{LICENSE_COMPOSER}}",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "inertiajs/inertia-laravel": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "{{ORGANIZATION_NAME}}\\{{MODULE_NAME}}\\": "src/",
            "{{ORGANIZATION_NAME}}\\{{MODULE_NAME}}\\Database\\": "database/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "{{ORGANIZATION_NAME}}\\{{MODULE_NAME}}\\{{MODULE_NAME}}ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
