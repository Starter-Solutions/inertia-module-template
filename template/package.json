        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "vite build",
        "dev": "vite build --watch",
        "prepack": "npm run build",
        "typecheck": "vue-tsc --noEmit"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^2.0 || ^3.0",
        "vue": "^3.5"
    },
    "devDependencies": {
        "@inertiajs/vue3": "^2.0.0",
        "@vitejs/plugin-vue": "^6.0.0",
        "typescript": "^5.9.0",
        "vite": "^7.0.0 || ^8.0.0",
        "vite-plugin-dts": "^4.5.0",
        "vue": "^3.5.0",
        "vue-tsc": "^3.0.0"
    }
