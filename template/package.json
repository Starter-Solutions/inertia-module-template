{
    "name": "@{{ORGANIZATION_SLUG}}/{{MODULE_SLUG}}",
    "version": "0.1.0",
    "description": "Headless frontend SDK for the {{MODULE_TITLE}} Laravel module.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/{{ORGANIZATION_SLUG}}/{{MODULE_SLUG}}.git"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./inertia": {
            "types": "./dist/inertia/index.d.ts",
            "import": "./dist/inertia/index.js"
        },
        "./composables": {
            "types": "./dist/composables/index.d.ts",
