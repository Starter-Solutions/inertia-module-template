{
    "name": "@starter-solutions/inertia-modules",
    "version": "0.1.0",
    "description": "Automatic Vite page discovery for modular Laravel and Inertia.js applications.",
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Starter-Solutions/inertia-module-template.git",
        "directory": "npm/inertia-modules"
    },
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "exports": {
