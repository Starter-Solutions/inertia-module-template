    ],
    "scripts": {
        "test": "node --test"
    },
    "dependencies": {
        "@babel/parser": "^7.28.0",
        "magic-string": "^0.30.0"
    },
    "peerDependencies": {
        "vite": "^7.0 || ^8.0"
    },
    "engines": {
        "node": ">=20.19.0"
    }
}
