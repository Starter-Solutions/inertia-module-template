#!/usr/bin/env php
<?php

declare(strict_types=1);

const TEMPLATE_DIRECTORY = __DIR__.'/template';

function fail(string $message, int $exitCode = 1): never
{
    fwrite(STDERR, "\033[31mError:\033[0m {$message}\n");
    exit($exitCode);
}

function info(string $message): void
{
    fwrite(STDOUT, "\033[32m✓\033[0m {$message}\n");
}

